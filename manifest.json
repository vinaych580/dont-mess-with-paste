{
  "manifest_version": 3,
  "name": "Don't Mess With Paste",
  "short_name": "No Paste Block",
  "version": "1.3.0",
  "description": "Force-enable copy, paste, cut, and text selection on websites that block these actions.",
  "permissions": ["activeTab", "storage", "contextMenus", "clipboardWrite", "clipboardRead"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Don't Mess With Paste",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "toggle-force-mode": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Toggle Force Mode for the current site"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dont-mess-with-paste@example.com",
      "strict_min_version": "109.0"
    }
  }
}
