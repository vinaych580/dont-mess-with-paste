{
  "manifest_version": 3,
  "name": "Don't Mess With Paste",
  "short_name": "No Paste Block",
  "version": "2.0.0",
  "description": "Makes paste work in Moodle VPL's restricted code editor, exactly as copied, without breaking copy.",
  "content_scripts": [
    {
      "matches": ["*://*/mod/vpl/*"],
      "js": ["paste-fix.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dont-mess-with-paste@example.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
